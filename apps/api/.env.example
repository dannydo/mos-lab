PORT=4001
# Production: https://lab.masteros.app | Local: http://localhost:3000
CORS_ORIGIN=https://lab.masteros.app
JWT_SECRET=<replace-with-strong-random-secret>

# Connection to Production MariaDB
LEGACY_DATABASE_URL="mysql://user:password@127.0.0.1:3306/management"
CRM_DATABASE_URL="mysql://user:password@127.0.0.1:3306/mos_lab"

# OmiCall Integration
OMICALL_API_KEY=<your-omicall-api-key>
OMICALL_WEBHOOK_SECRET=<webhook-verification-secret>
OMICALL_SIP_DOMAIN=sip.omicall.com

# SIP Encryption Key (32-byte secret)
SIP_ENCRYPTION_KEY=<random-32-byte-hex-string>

# Sales Academy cutover: server-side credentials only (never expose in apps/web)
ACADEMY_SUPABASE_URL=https://<project>.supabase.co
ACADEMY_SUPABASE_SERVICE_KEY=<service-role-key-used-only-for-one-time-backfill>
# Private Workshop media bucket. The service key remains server-only and is
# used to create short-lived upload/read URLs; never expose it as NEXT_PUBLIC_*.
ACADEMY_WORKSHOP_MEDIA_BUCKET=academy-workshop-media
ACADEMY_WORKSHOP_PARTICIPANT_JWT_SECRET=<replace-with-a-separate-strong-random-secret>
# Public frontend origin used when generating participant QR and display links.
ACADEMY_WORKSHOP_PUBLIC_URL=https://lab.masteros.app
PANCAKE_JWT=<pancake-server-session-token>
# PANCAKE_COOKIE=<optional-pancake-cookie-if-required-by-the-source>
# Explicit Academy source configuration. Keep IDs server-side with the token.
ACADEMY_PANCAKE_POS_SHOP_ID=<academy-pos-shop-id>
ACADEMY_PANCAKE_FACEBOOK_PAGE_IDS=<facebook-page-id-1,facebook-page-id-2>
ACADEMY_PANCAKE_TIKTOK_PAGE_IDS=<tiktok-inbox-id-1,tiktok-inbox-id-2>
# The scheduler is disabled unless explicitly enabled. Default interval: 60 minutes; minimum: 15.
ACADEMY_PANCAKE_SYNC_ENABLED=true
ACADEMY_PANCAKE_SYNC_INTERVAL_MINUTES=60
