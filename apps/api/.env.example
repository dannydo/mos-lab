PORT=4001
# Production: https://lab.masteros.app | Local: http://localhost:3000
CORS_ORIGIN=https://lab.masteros.app
JWT_SECRET=<replace-with-strong-random-secret>

# Connection to Production MariaDB
LEGACY_DATABASE_URL="mysql://user:password@127.0.0.1:3306/management"
CRM_DATABASE_URL="mysql://user:password@127.0.0.1:3306/mos_lab"

# OmiCall Integration
OMICALL_API_KEY=<your-omicall-api-key>
OMICALL_WEBHOOK_SECRET=<webhook-verification-secret>
OMICALL_SIP_DOMAIN=sip.omicall.com

# SIP Encryption Key (32-byte secret)
SIP_ENCRYPTION_KEY=<random-32-byte-hex-string>


