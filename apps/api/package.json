{
  "name": "@mos-lab/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm prisma:generate && tsc && pnpm postbuild",
    "postbuild": "rm -rf dist/generated && cp -r src/generated dist/generated && mkdir -p dist/modules/qa-shop && cp src/modules/qa-shop/*.json dist/modules/qa-shop/ 2>/dev/null || true",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=prisma/legacy.prisma && prisma generate --schema=prisma/crm.prisma",
    "prisma:migrate:crm": "prisma migrate dev --schema=prisma/crm.prisma --name init",
    "schema:apply:crm": "prisma db push --schema=prisma/crm.prisma --skip-generate",
    "data-migrations:validate": "tsx src/scripts/run-data-migrations.ts --validate",
    "data-migrations:plan": "tsx src/scripts/run-data-migrations.ts --plan",
    "data-migrations:run": "tsx src/scripts/run-data-migrations.ts",
    "post-hub:import-history": "tsx src/scripts/import-post-hub-sheet-history.ts",
    "legacy:indexes:phase1": "tsx src/scripts/apply-dashboard-phase1-indexes.ts",
    "legacy:indexes:customers": "tsx src/scripts/apply-customer-query-perf-indexes.ts",
    "lint": "eslint src/ --max-warnings=-1",
    "prisma:db:pull:legacy": "prisma db pull --schema=prisma/legacy.prisma"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/websocket": "11.3.0",
    "@mos-lab/shared": "workspace:*",
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "2.109.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "mysql2": "^3.12.0",
    "undici": "^6.21.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0"
  }
}
