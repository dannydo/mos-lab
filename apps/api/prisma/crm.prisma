// Durable, idempotent planning work. The outbound Mac worker can only post a
// reviewable plan; it has no authority to implement or deploy a ticket.
model CrmInboxPlanJob {
  id String @id @db.VarChar(36)
  reportId Int @map("report_id")
  eventKind String @map("event_kind") @db.VarChar(32)
  eventVersion String @map("event_version") @db.VarChar(80)
  status String @default("PENDING") @db.VarChar(16)
  attemptCount Int @default(0) @map("attempt_count")
  leaseToken String? @map("lease_token") @db.VarChar(64)
  leasedBy String? @map("leased_by") @db.VarChar(100)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.DateTime(0)
  resultAction String? @map("result_action") @db.VarChar(32)
  sourceVersion String? @map("source_version") @db.VarChar(80)
  planVersion String? @map("plan_version") @db.VarChar(80)
  reviewCommentId Int? @map("review_comment_id")
  fallbackReason String? @map("fallback_reason") @db.VarChar(400)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  report CrmBugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, eventVersion])
  @@index([status, expiresAt])
  @@index([leaseExpiresAt])
  @@map("crm_inbox_plan_jobs")
}

/// A durable, single-concurrency implementation lease. Worktrees are retained
/// for Danny's review and no row implies permission to commit or deploy.
model CrmInboxImplementationJob {
  id String @id @db.VarChar(36)
  reportId Int @map("report_id")
  sourceVersion String @map("source_version") @db.VarChar(80)
  planVersion String @map("plan_version") @db.VarChar(80)
  retryOfJobId String? @map("retry_of_job_id") @db.VarChar(36)
  retrySequence Int @default(0) @map("retry_sequence")
  status String @default("PENDING") @db.VarChar(32)
  attemptCount Int @default(0) @map("attempt_count")
  leaseToken String? @map("lease_token") @db.VarChar(64)
  leasedBy String? @map("leased_by") @db.VarChar(100)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.DateTime(0)
  leaseHeartbeatAt DateTime? @map("lease_heartbeat_at") @db.DateTime(0)
  processPid Int? @map("process_pid")
  executionPhase String @default("QUEUED") @map("execution_phase") @db.VarChar(32)
  branchName String @map("branch_name") @db.VarChar(160)
  worktreePath String? @map("worktree_path") @db.VarChar(500)
  summary String? @db.Text
  changedFilesJson String? @map("changed_files_json") @db.LongText
  testsJson String? @map("tests_json") @db.LongText
  diffStat String? @map("diff_stat") @db.Text
  risksAndRollback String? @map("risks_and_rollback") @db.Text
  failureCode String? @map("failure_code") @db.VarChar(100)
  retainUntil DateTime? @map("retain_until") @db.DateTime(0)
  startedAt DateTime? @map("started_at") @db.DateTime(0)
  completedAt DateTime? @map("completed_at") @db.DateTime(0)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  report CrmBugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sourceVersion, planVersion, retrySequence])
  @@index([status, expiresAt])
  @@index([leaseExpiresAt])
  @@index([retryOfJobId])
  @@map("crm_inbox_implementation_jobs")
}

/// Fixed singleton row used as a database-backed global build permit.
model CrmInboxImplementationWorkerLock {
  id Int @id @default(1)
  activeJobId String? @map("active_job_id") @db.VarChar(36)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("crm_inbox_implementation_worker_lock")
}
