  note             String?   @db.Text
  ownerStaffId     Int?      @map("owner_staff_id")
  legacyOwnerEmail String?   @map("legacy_owner_email") @db.VarChar(150)
  createdByStaffId Int?      @map("created_by_staff_id")
  sourceCreatedAt  DateTime? @map("source_created_at") @db.DateTime(0)
