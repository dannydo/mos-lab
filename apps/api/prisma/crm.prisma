  joinedAt      DateTime  @default(now()) @map("joined_at") @db.DateTime(0)
  leftAt        DateTime? @map("left_at") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  team CrmTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, legacyStaffId], name: "teamId_legacyStaffId")
  @@index([legacyStaffId])
  @@index([crmStaffId])
  @@index([isActive])
  @@map("crm_team_members")
}

/// Visibility policy for one static sidebar menu key. It deliberately controls
/// discovery only; individual API modules remain the authorization boundary.
model CrmMenuAccessPolicy {
  id           Int      @id @default(autoincrement())
  menuKey      String   @unique @map("menu_key") @db.VarChar(80)
  isRestricted Boolean  @default(false) @map("is_restricted") @db.TinyInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  rules CrmMenuAccessRule[]

  @@index([isRestricted])
  @@map("crm_menu_access_policies")
}

/// Subject IDs are validated by MenuAccessService before every write. Keeping
/// them generic permits Department, Team and individual-staff grants in one
/// immutable policy ledger without weakening any underlying route guard.
model CrmMenuAccessRule {
  id          Int      @id @default(autoincrement())
  policyId    Int      @map("policy_id")
  subjectType String   @map("subject_type") @db.VarChar(16)
  subjectId   Int      @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  policy CrmMenuAccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, subjectType, subjectId], name: "policyId_subjectType_subjectId")
  @@index([subjectType, subjectId])
  @@map("crm_menu_access_rules")
}

/// Append-only evidence for policy changes. It supports later review of who
/// narrowed or expanded a menu audience and the exact before/after scopes.
model CrmMenuAccessAudit {
  id           Int      @id @default(autoincrement())
  menuKey      String   @map("menu_key") @db.VarChar(80)
  actorStaffId Int?     @map("actor_staff_id")
  beforeJson   String?  @map("before_json") @db.Text
  afterJson    String?  @map("after_json") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([menuKey, createdAt])
  @@index([actorStaffId, createdAt])
  @@map("crm_menu_access_audits")
}

