  id                 String    @id @db.VarChar(36)
  reporterStaffId    Int       @map("reporter_staff_id")
  description        String    @db.Text
  contextJson        String    @map("context_json") @db.LongText
  status             String    @default("PENDING") @db.VarChar(16)
  attemptCount       Int       @default(0) @map("attempt_count")
  leaseToken         String?   @map("lease_token") @db.VarChar(64)
  leasedBy           String?   @map("leased_by") @db.VarChar(100)
  leasedAt           DateTime? @map("leased_at") @db.DateTime(0)
  leaseExpiresAt     DateTime? @map("lease_expires_at") @db.DateTime(0)
  recommendationJson String?   @map("recommendation_json") @db.LongText
  fallbackReason     String?   @map("fallback_reason") @db.VarChar(400)
  consumedAt         DateTime? @map("consumed_at") @db.DateTime(0)
  expiresAt          DateTime  @map("expires_at") @db.DateTime(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  reporter    CrmStaff                               @relation("RequestClassificationReporter", fields: [reporterStaffId], references: [id], onDelete: Cascade)
  attachments CrmRequestClassificationJobAttachment[]

  @@index([reporterStaffId, createdAt])
  @@index([status, expiresAt])
  @@index([leaseExpiresAt])
  @@map("crm_request_classification_jobs")
}

model CrmRequestClassificationJobAttachment {
  id           Int      @id @default(autoincrement())
  jobId        String   @map("job_id") @db.VarChar(36)
  originalName String   @map("original_name") @db.VarChar(255)
  storagePath  String   @unique @map("storage_path") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(50)
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(0)

  job CrmRequestClassificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("crm_request_classification_job_attachments")
}

model CrmRequestClassificationWorkerHeartbeat {
  workerId  String   @id @map("worker_id") @db.VarChar(100)
  lastSeenAt DateTime @map("last_seen_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([lastSeenAt])
  @@map("crm_request_classification_worker_heartbeats")
}

/// Server-authoritative operational state for the outbound Inbox worker.
/// This intentionally stores only bounded runtime metadata, never ticket or
/// intake content. The legacy heartbeat table above remains a compatibility
/// touchpoint for the existing claim routes.
model CrmRequestClassifierWorkerHealth {
  workerId                  String    @id @map("worker_id") @db.VarChar(100)
  workerVersion             String    @map("worker_version") @db.VarChar(100)
  sessionId                 String    @map("session_id") @db.VarChar(64)
  lastSequence              Int       @default(0) @map("last_sequence")
  lastClientSentAt          DateTime  @map("last_client_sent_at") @db.DateTime(3)
  lastHeartbeatAt           DateTime  @map("last_heartbeat_at") @db.DateTime(0)
  connectionMode            String    @map("connection_mode") @db.VarChar(20)
  activeJobKind             String?   @map("active_job_kind") @db.VarChar(32)
  activeJobStartedAt        DateTime? @map("active_job_started_at") @db.DateTime(0)
  lastOutcomeKind           String?   @map("last_outcome_kind") @db.VarChar(32)
  lastOutcomeStatus         String?   @map("last_outcome_status") @db.VarChar(16)
  lastOutcomeSeverity       String?   @map("last_outcome_severity") @db.VarChar(16)
  lastOutcomeCode           String?   @map("last_outcome_code") @db.VarChar(100)
  lastOutcomeClientAt       DateTime? @map("last_outcome_client_at") @db.DateTime(3)
  lastOutcomeAt             DateTime? @map("last_outcome_at") @db.DateTime(0)
  lastCompletedAt           DateTime? @map("last_completed_at") @db.DateTime(0)
  lastFailedAt              DateTime? @map("last_failed_at") @db.DateTime(0)
  consecutiveFailureCount   Int       @default(0) @map("consecutive_failure_count")
  state                     String    @default("OFFLINE") @db.VarChar(16)
  stateReason               String    @default("NO_HEARTBEAT") @map("state_reason") @db.VarChar(100)
  stateChangedAt            DateTime  @map("state_changed_at") @db.DateTime(0)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  transitions CrmRequestClassifierWorkerHealthTransition[]

  @@index([lastHeartbeatAt], map: "request_classifier_worker_health_seen_idx")
  @@index([state, lastHeartbeatAt], map: "request_classifier_worker_health_state_seen_idx")
  @@map("crm_request_classifier_worker_health")
}

model CrmRequestClassifierWorkerHealthTransition {
  id         Int      @id @default(autoincrement())
  workerId   String   @map("worker_id") @db.VarChar(100)
  fromState  String?  @map("from_state") @db.VarChar(16)
  toState    String   @map("to_state") @db.VarChar(16)
  reason     String   @db.VarChar(100)
  occurredAt DateTime @map("occurred_at") @db.DateTime(0)

  worker CrmRequestClassifierWorkerHealth @relation(fields: [workerId], references: [workerId], onDelete: Cascade)

  @@index([workerId, occurredAt], map: "request_classifier_worker_transition_worker_time_idx")
  @@map("crm_request_classifier_worker_health_transitions")
}

// Private, short-lived conversation state. Message text is only available to the
// reporter and the authenticated outbound worker; audit rows store event metadata only.
model CrmRequestConversation {
  id                   String    @id @db.VarChar(36)
  reporterStaffId      Int       @map("reporter_staff_id")
  preferredRequestType String?   @map("preferred_request_type") @db.VarChar(16)
  description          String    @db.Text
  contextJson          String    @map("context_json") @db.LongText
  attachmentCount      Int       @default(0) @map("attachment_count")
  summaryJson          String    @map("summary_json") @db.LongText
  messagesJson         String    @map("messages_json") @db.LongText
  status               String    @default("PENDING") @db.VarChar(20)
  nextQuestion         String?   @map("next_question") @db.Text
  fallbackReason       String?   @map("fallback_reason") @db.VarChar(400)
  attemptCount         Int       @default(0) @map("attempt_count")
  leaseToken           String?   @map("lease_token") @db.VarChar(64)
  leasedBy             String?   @map("leased_by") @db.VarChar(100)
  leasedAt             DateTime? @map("leased_at") @db.DateTime(0)
  leaseExpiresAt       DateTime? @map("lease_expires_at") @db.DateTime(0)
  readyAt              DateTime? @map("ready_at") @db.DateTime(0)
  consumedAt           DateTime? @map("consumed_at") @db.DateTime(0)
  expiresAt            DateTime  @map("expires_at") @db.DateTime(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  reporter CrmStaff                    @relation("RequestConversationReporter", fields: [reporterStaffId], references: [id], onDelete: Cascade)
  audits   CrmRequestConversationAudit[]

  @@index([reporterStaffId, createdAt])
  @@index([status, expiresAt])
  @@index([leaseExpiresAt])
  @@map("crm_request_conversations")
}

model CrmRequestConversationAudit {
  id             Int      @id @default(autoincrement())
  conversationId String   @map("conversation_id") @db.VarChar(36)
  action         String   @db.VarChar(50)
  metadataJson   String?  @map("metadata_json") @db.LongText
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)

  conversation CrmRequestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("crm_request_conversation_audits")
}

model CrmInboxFollowUpJob {
  id String @id @db.VarChar(36)
  reportId Int @map("report_id")
  eventKind String @map("event_kind") @db.VarChar(32)
  eventVersion String @map("event_version") @db.VarChar(80)
  status String @default("PENDING") @db.VarChar(16)
  attemptCount Int @default(0) @map("attempt_count")
  leaseToken String? @map("lease_token") @db.VarChar(64)
  leasedBy String? @map("leased_by") @db.VarChar(100)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.DateTime(0)
  resultAction String? @map("result_action") @db.VarChar(32)
  fallbackReason String? @map("fallback_reason") @db.VarChar(400)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  report CrmBugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
