datasource db {
  provider = "mysql"
  url      = env("CRM_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/crm-client"
}

model CrmStaff {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  role         String   @default("telesales") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active") @db.TinyInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  
  // HR System Extensions
  email            String?   @db.VarChar(100)
  phone            String?   @db.VarChar(20)
  joinedAt         DateTime? @map("joined_at") @db.Date
  birthDate        DateTime? @map("birth_date") @db.Date
  gender           String?   @db.VarChar(10)
  address          String?   @db.Text
  emergencyContact String?   @map("emergency_contact") @db.VarChar(100)
  emergencyPhone   String?   @map("emergency_phone") @db.VarChar(20)
  avatarUrl        String?   @map("avatar_url") @db.VarChar(255)
  notes            String?   @db.Text
  legacyStaffId    Int?      @map("legacy_staff_id")
  lastLoginAt      DateTime? @map("last_login_at") @db.DateTime(0)
  lastActiveAt     DateTime? @map("last_active_at") @db.DateTime(0)
  omicallAutoInit  Boolean?  @map("omicall_auto_init") @db.TinyInt
  baseSalary       Float?    @map("base_salary")
  hourlyWage       Float?    @map("hourly_wage")
  seniorityOffset  Int?      @map("seniority_offset") @default(0)

  customerAssignments CrmCustomerAssignment[]
  prevHistory         CrmAssignmentHistory[] @relation("PrevStaffHistory")
  newHistory          CrmAssignmentHistory[] @relation("NewStaffHistory")
  assignedHistory     CrmAssignmentHistory[] @relation("AssignerHistory")
  assignedBatches     CrmAllocationBatch[]   @relation("BatchAssigner")
  receivedBatches     CrmAllocationBatch[]   @relation("BatchBooker")

  @@map("crm_staff")
}

model CrmDailyPlan {
  id           Int      @id @default(autoincrement())
  legacyUserId Int      @map("legacy_user_id")
  staffId      Int      @map("staff_id")
  plannedDate  DateTime @map("planned_date") @db.Date
  bucket       String?  @db.VarChar(20)
  priority     Int      @default(0)
  status       String   @default("PLANNED") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([legacyUserId, plannedDate], name: "legacyUserId_plannedDate")
  @@index([staffId, plannedDate])
  @@map("crm_daily_plans")
}

model CrmCallLog {
  id           Int       @id @default(autoincrement())
  planId       Int?      @map("plan_id")
  legacyUserId Int       @map("legacy_user_id")
  staffId      Int       @map("staff_id")
  callType     String    @map("call_type") @db.VarChar(20)
  callResult   String?   @map("call_result") @db.VarChar(20)
  durationSec  Int?      @map("duration_sec")
  note         String?   @db.Text
  outcome      String?   @db.VarChar(30)
  callbackDate DateTime? @map("callback_date") @db.Date
  callUuid     String?   @map("call_uuid") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([legacyUserId])
  @@index([staffId])
  @@index([createdAt])
  @@index([staffId, createdAt])
  @@map("crm_call_logs")
}

model CrmStaffKpi {
  id            Int      @id @default(autoincrement())
  staffId       Int      @map("staff_id")
  kpiDate       DateTime @map("kpi_date") @db.Date
  totalPlanned  Int      @default(0) @map("total_planned")
  totalCalled   Int      @default(0) @map("total_called")
  totalAnswered Int      @default(0) @map("total_answered")
  totalBooked   Int      @default(0) @map("total_booked")
  totalRenewed  Int      @default(0) @map("total_renewed")

  @@unique([staffId, kpiDate], name: "staffId_kpiDate")
  @@map("crm_staff_kpi")
}

model CrmConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("crm_config")
}

model CrmCustomerAssignment {
  id                   Int       @id @default(autoincrement())
  legacyUserId         Int       @unique @map("legacy_user_id")
  staffId              Int?      @map("staff_id")
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.DateTime(0)
  assignedBy           Int?      @map("assigned_by")
  expiresAt            DateTime? @map("expires_at") @db.DateTime(0)
  assignedDurationDays Int?      @map("assigned_duration_days")
  isRetained           Boolean   @default(false) @map("is_retained") @db.TinyInt
  retainedAt           DateTime? @map("retained_at") @db.DateTime(0)
  staff                CrmStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@map("crm_customer_assignments")
}

model CrmRole {
  key         String   @id @db.VarChar(20)
  name        String   @db.VarChar(100)
  color       String   @default("default") @db.VarChar(20)
  viewKPI     Boolean  @default(false) @map("view_kpi") @db.TinyInt
  viewTeamKPI Boolean  @default(false) @map("view_team_kpi") @db.TinyInt
  manageStaff Boolean  @default(false) @map("manage_staff") @db.TinyInt
  omicallAutoInit Boolean @default(false) @map("omicall_auto_init") @db.TinyInt
  isSystem    Boolean  @default(false) @map("is_system") @db.TinyInt
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@map("crm_roles")
}

model CrmAssignmentHistory {
  id                  Int       @id @default(autoincrement())
  batchId             String    @map("batch_id") @db.VarChar(50)
  legacyUserId        Int       @map("legacy_user_id")
  prevStaffId         Int?      @map("prev_staff_id")
  newStaffId          Int?      @map("new_staff_id")
  assignedBy          Int       @map("assigned_by")
  assignedAt          DateTime  @default(now()) @map("assigned_at") @db.DateTime(0)
  expiresAt           DateTime? @map("expires_at") @db.DateTime(0)
  sourceType          String    @default("MANUAL") @map("source_type") @db.VarChar(20)
  sourceFilterJson    String?   @map("source_filter_json") @db.Text
  sourceFilterSummary String?   @map("source_filter_summary") @db.Text
  actionType          String    @default("ASSIGN") @map("action_type") @db.VarChar(20)
  reason              String?   @map("reason") @db.Text
  isUndone            Boolean   @default(false) @map("is_undone") @db.TinyInt
  undoneAt            DateTime? @map("undone_at") @db.DateTime(0)

  prevStaff           CrmStaff? @relation("PrevStaffHistory", fields: [prevStaffId], references: [id], onDelete: SetNull)
  newStaff            CrmStaff? @relation("NewStaffHistory", fields: [newStaffId], references: [id], onDelete: SetNull)
  assigner            CrmStaff  @relation("AssignerHistory", fields: [assignedBy], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([legacyUserId])
  @@map("crm_assignment_history")
}

// ═══════════════════════════════════════════
// OmiCall Integration — Raw webhook data + AI results
// ═══════════════════════════════════════════
model CrmOmicallLog {
  id                Int       @id @default(autoincrement())
  callUuid          String    @unique @map("call_uuid") @db.VarChar(100)
  direction         String    @db.VarChar(10)           // 'outbound' | 'inbound'
  status            String    @db.VarChar(20)           // 'ANSWER' | 'NOANSWER' | 'BUSY' | 'CANCEL'
  sourceNumber      String    @map("source_number") @db.VarChar(20)
  destinationNumber String    @map("destination_number") @db.VarChar(20)
  duration          Int       @default(0)               // total seconds
  billSec           Int       @default(0) @map("bill_sec") // billable seconds
  recordingUrl      String?   @map("recording_url") @db.VarChar(500)
  timeStartCall     DateTime? @map("time_start_call") @db.DateTime(0)
  timeEndCall       DateTime? @map("time_end_call") @db.DateTime(0)

  // Linking
  staffId           Int?      @map("staff_id")          // matched CRM staff
  legacyUserId      Int?      @map("legacy_user_id")    // matched customer
  callLogId         Int?      @map("call_log_id")       // linked CrmCallLog (notes/tags)

  // AI Analysis
  analysisStatus    String    @default("PENDING") @map("analysis_status") @db.VarChar(20)
                              // PENDING → WAITING_RECORDING → PROCESSING → DONE → FAILED | SKIPPED
  analysisRetryCount Int      @default(0) @map("analysis_retry_count")
  analysisError     String?   @map("analysis_error") @db.Text
  laughCount        Int?      @map("laugh_count")
  laughCountAgent     Int?      @map("laugh_count_agent")
  laughCountCustomer  Int?      @map("laugh_count_customer")
  laughTimestamps   String?   @map("laugh_timestamps") @db.Text
                              // JSON: [{"start":12.5,"end":14.2,"speaker":"agent"|"customer","confidence":0.92}, ...]
  transcript        String?   @db.LongText

  // Customer Satisfaction (CSAT) Evaluation Fields
  customerSatisfactionScore Int?    @map("customer_satisfaction_score")
  customerSentiment         String? @map("customer_sentiment") @db.VarChar(20)
  satisfactionAnalysis      String? @map("satisfaction_analysis") @db.Text

  // Happy Call Status (thay thế isHappyCall boolean)
  happyCallStatus   String    @default("NONE") @map("happy_call_status") @db.VarChar(20)
                              // NONE | APPROVED | PENDING_APPROVAL | REJECTED
  happyCallReason   String?   @map("happy_call_reason") @db.VarChar(30)
                              // 'auto_180s' | 'auto_laughter_30s' | 'manual_approved' | null

  // QA Verification (Positive Feedback per laugh)
  qaVerified        Boolean   @default(false) @map("qa_verified") @db.TinyInt
  qaVerifiedBy      Int?      @map("qa_verified_by")
  qaVerifiedAt      DateTime? @map("qa_verified_at") @db.DateTime(0)
  qaLaughVerifications String? @map("qa_laugh_verifications") @db.Text
                              // JSON: [{"timestamp":12.5,"verified":true}, {"timestamp":45.8,"verified":false}]
  qaNotes           String?   @map("qa_notes") @db.Text
  qaScore           Int?      @map("qa_score")
  qaTags            String?   @map("qa_tags") @db.Text
  qaChecklist       String?   @map("qa_checklist") @db.Text

  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([staffId])
  @@index([legacyUserId])
  @@index([analysisStatus])
  @@index([happyCallStatus])
  @@index([createdAt])
  @@index([destinationNumber])
  @@index([status, createdAt])
  @@map("crm_omicall_logs")
}

// ═══════════════════════════════════════════
// OmiCall Config — API keys, extension mapping
// ═══════════════════════════════════════════
model CrmOmicallConfig {
  id           Int    @id @default(autoincrement())
  staffId      Int    @unique @map("staff_id")
  extension    String @db.VarChar(20)          // SIP extension number
  phoneNumber  String? @map("phone_number") @db.VarChar(20) // Outbound caller ID
  sipPassword  String? @map("sip_password") @db.VarChar(255) // SIP password (đã mã hóa)

  @@map("crm_omicall_config")
}

model CrmMissedLog {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique @map("order_id")
  reasonCategory String   @map("reason_category") @db.VarChar(50)
  responsibility String   @db.VarChar(50)
  note           String?  @db.Text
  followUpStatus String   @default("PENDING") @map("follow_up_status") @db.VarChar(30)
  callbackDate   DateTime? @map("callback_date") @db.Date
  createdBy      String?  @map("created_by") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([reasonCategory])
  @@index([responsibility])
  @@index([followUpStatus])
  @@index([createdAt])
  @@map("crm_missed_logs")
}

// ═══════════════════════════════════════════
// Team Configuration — Unified team/group management
// ═══════════════════════════════════════════
model CrmTeam {
  id            Int             @id @default(autoincrement())
  code          String          @unique @db.VarChar(30)        // CC, CV, BK, BK_TELESALES...
  name          String          @db.VarChar(100)               // Display name
  description   String?         @db.Text
  color         String?         @db.VarChar(30)                // Hex or named color
  icon          String?         @db.VarChar(50)                // Emoji or icon name
  sortOrder     Int             @default(0) @map("sort_order")
  isActive      Boolean         @default(true) @map("is_active") @db.TinyInt
  parentTeamId  Int?            @map("parent_team_id")
  metadata      String?         @db.Text                       // JSON: salary config, bonus formula
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.DateTime(0)

  // Self-referencing hierarchy
  parent        CrmTeam?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children      CrmTeam[]       @relation("TeamHierarchy")
  members       CrmTeamMember[]

  @@index([parentTeamId])
  @@index([isActive])
  @@map("crm_teams")
}

model CrmTeamMember {
  id              Int       @id @default(autoincrement())
  teamId          Int       @map("team_id")
  legacyStaffId   Int       @map("legacy_staff_id")
  crmStaffId      Int?      @map("crm_staff_id")
  displayName     String?   @map("display_name") @db.VarChar(100)
  role            String?   @db.VarChar(20)                  // leader, member, trainee
  isActive        Boolean   @default(true) @map("is_active") @db.TinyInt
  sortOrder       Int       @default(0) @map("sort_order")
  joinedAt        DateTime  @default(now()) @map("joined_at") @db.DateTime(0)
  leftAt          DateTime? @map("left_at") @db.DateTime(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  team            CrmTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, legacyStaffId], name: "teamId_legacyStaffId")
  @@index([legacyStaffId])
  @@index([crmStaffId])
  @@index([isActive])
  @@map("crm_team_members")
}

// ═══════════════════════════════════════════
// Booking Audit Logs — Trace changes & cross-booker cancellations
// ═══════════════════════════════════════════
model CrmBookingLog {
  id                  Int      @id @default(autoincrement())
  orderId             Int      @map("order_id")
  actionType          String   @map("action_type") @db.VarChar(30) // CANCEL, RESCHEDULE, CHANGE_KTV, CHANGE_STORE, EDIT
  actorStaffId        Int      @map("actor_staff_id")
  actorStaffName      String?  @map("actor_staff_name") @db.VarChar(100)
  originalStaffId     Int?     @map("original_staff_id")
  originalStaffName   String?  @map("original_staff_name") @db.VarChar(100)
  isCrossAction       Boolean  @default(false) @map("is_cross_action")
  reasonCategory      String?  @map("reason_category") @db.VarChar(100)
  reasonNote          String?  @map("reason_note") @db.Text
  oldDataJson         String?  @map("old_data_json") @db.Text
  newDataJson         String?  @map("new_data_json") @db.Text
  ipAddress           String?  @map("ip_address") @db.VarChar(45)
  dateCreated         DateTime @default(now()) @map("date_created") @db.DateTime(0)

  @@index([orderId])
  @@index([actorStaffId])
  @@index([originalStaffId])
  @@index([isCrossAction])
  @@index([dateCreated])
  @@map("crm_booking_logs")
}

// ═══════════════════════════════════════════
// Customer Allocation System — 2-step verification, 24h countdown, 30-day retention
// ═══════════════════════════════════════════
model CrmAllocationBatch {
  id                 Int       @id @default(autoincrement())
  batchCode          String    @unique @map("batch_code") @db.VarChar(50)
  assignerId         Int       @map("assigner_id")
  bookerId           Int       @map("booker_id")
  totalCount         Int       @map("total_count")
  status             String    @default("PENDING_ACCEPT") @db.VarChar(20) // PENDING_ACCEPT | ACCEPTED | DECLINED | EXPIRED | RECALLED
  declineReason      String?   @map("decline_reason") @db.Text
  declineCategory    String?   @map("decline_category") @db.VarChar(100)
  declineNote        String?   @map("decline_note") @db.Text
  expiresAt          DateTime  @map("expires_at") @db.DateTime(0) // 24h countdown target
  acceptedAt         DateTime? @map("accepted_at") @db.DateTime(0)
  declinedAt         DateTime? @map("declined_at") @db.DateTime(0)
  recalledAt         DateTime? @map("recalled_at") @db.DateTime(0)
  retentionExpiresAt DateTime? @map("retention_expires_at") @db.DateTime(0) // 30-day countdown target
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  assigner CrmStaff                 @relation("BatchAssigner", fields: [assignerId], references: [id], onDelete: Cascade)
  booker   CrmStaff                 @relation("BatchBooker", fields: [bookerId], references: [id], onDelete: Cascade)
  items    CrmAllocationBatchItem[]

  @@index([bookerId])
  @@index([assignerId])
  @@index([status])
  @@index([expiresAt])
  @@map("crm_allocation_batches")
}

model CrmAllocationBatchItem {
  id                 Int      @id @default(autoincrement())
  batchId            Int      @map("batch_id")
  customerId         Int      @map("customer_id")
  customerName       String?  @map("customer_name") @db.VarChar(100)
  customerPhone      String?  @map("customer_phone") @db.VarChar(20)
  bucket             String?  @db.VarChar(50)
  daysSinceLastVisit Int?     @map("days_since_last_visit")
  totalSpent         Float?   @map("total_spent")
  status             String   @default("PENDING_ACCEPT") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(0)

  batch CrmAllocationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, customerId], name: "batchId_customerId")
  @@index([customerId])
  @@index([batchId])
  @@index([status])
  @@map("crm_allocation_batch_items")
}






