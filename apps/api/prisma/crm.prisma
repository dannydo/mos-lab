// ═══════════════════════════════════════════
// mOS Bug Inbox — employee reports and Danny triage
// ═══════════════════════════════════════════
model CrmBugReport {
  id                Int       @id @default(autoincrement())
  reporterStaffId   Int       @map("reporter_staff_id")
  requestType       String    @default("BUG") @map("request_type") @db.VarChar(16)
  requestMetadataJson String? @map("request_metadata_json") @db.LongText
  title             String    @db.VarChar(180)
  description       String    @db.Text
  searchNormalized  String    @map("search_normalized") @db.Text
  status            String    @default("NEW") @db.VarChar(20)
  priority          String?   @db.VarChar(2)
  statusSort        Int       @default(0) @map("status_sort")
  prioritySort      Int       @default(4) @map("priority_sort")
  businessContext   String?   @map("business_context") @db.Text
  triageNote        String?   @map("triage_note") @db.Text
  clarificationStatus String    @default("PENDING_AGENT") @map("clarification_status") @db.VarChar(24)
  clarificationSummary String?   @map("clarification_summary") @db.Text
  clarifiedAt          DateTime? @map("clarified_at") @db.DateTime(0)
  duplicateOfId     Int?      @map("duplicate_of_id")
  approvedByStaffId Int?      @map("approved_by_staff_id")
  approvedAt        DateTime? @map("approved_at") @db.DateTime(0)
  implementationApprovedByStaffId Int? @map("implementation_approved_by_staff_id")
  implementationApprovedAt DateTime? @map("implementation_approved_at") @db.DateTime(0)
  implementationApprovalSourceVersion String? @map("implementation_approval_source_version") @db.VarChar(80)
  implementationActiveJobId String? @map("implementation_active_job_id") @db.VarChar(36)
  startedAt         DateTime? @map("started_at") @db.DateTime(0)
  resolvedAt        DateTime? @map("resolved_at") @db.DateTime(0)
  closedAt          DateTime? @map("closed_at") @db.DateTime(0)
  sourcePath        String    @map("source_path") @db.VarChar(500)
  contextJson       String    @map("context_json") @db.LongText
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  reporter    CrmStaff       @relation("BugReportReporter", fields: [reporterStaffId], references: [id], onDelete: Restrict)
  approver    CrmStaff?      @relation("BugReportApprover", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  duplicateOf CrmBugReport?  @relation("BugReportDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  CrmBugReport[] @relation("BugReportDuplicates")
  attachments CrmBugReportAttachment[]
  audits      CrmBugReportAudit[]
  resolution  CrmBugReportResolution?
  notifications CrmBugReportNotification[]
  comments CrmBugReportComment[]
  inboxFollowUpJobs CrmInboxFollowUpJob[]
  inboxPlanJobs CrmInboxPlanJob[]
  inboxImplementationJobs CrmInboxImplementationJob[]

  @@index([statusSort, prioritySort, createdAt])
  @@index([requestType, statusSort, prioritySort, createdAt], map: "bug_request_type_status_idx")
  @@index([status, priority, createdAt])
  @@index([reporterStaffId, createdAt])
  @@index([duplicateOfId])
  @@map("crm_bug_reports")
}

