/// Native talent-workshop session. Course and amount information is stored as
/// serialized snapshots so an issued tuition document never changes when a
/// course catalogue record is later edited.
model CrmAcademyTalentAssessment {
  id                    Int       @id @default(autoincrement())
  leadId                Int       @map("lead_id")
  evaluatorStaffId      Int?      @map("evaluator_staff_id")
  status                String    @default("DRAFT") @db.VarChar(20)
  eyeScore              Int       @default(0) @map("eye_score")
  handScore             Int       @default(0) @map("hand_score")
  strands5Min           Int       @default(0) @map("strands_5_min")
  errorRoot             Int       @default(0) @map("error_root")
  errorSkin             Int       @default(0) @map("error_skin")
  errorStickies         Int       @default(0) @map("error_stickies")
  errorDirection        Int       @default(0) @map("error_direction")
  offerExpiresAt        DateTime  @map("offer_expires_at") @db.DateTime(0)
  selectedCourseIds     String?   @map("selected_course_ids") @db.LongText
  selectedSampleCourseIds String? @map("selected_sample_course_ids") @db.LongText
  selectedKitCourseIds  String?   @map("selected_kit_course_ids") @db.LongText
  selectedInstructorIdsByCourse String? @map("selected_instructor_ids_by_course") @db.LongText
  courseSnapshotJson    String?   @map("course_snapshot_json") @db.LongText
  quoteSnapshotJson     String?   @map("quote_snapshot_json") @db.LongText
  paymentMode           String    @default("THINKING") @map("payment_mode") @db.VarChar(20)
  depositVnd            Int       @default(0) @map("deposit_vnd")
  notes                 String?   @db.Text
  invoiceNumber         String?   @unique @map("invoice_number") @db.VarChar(80)
  invoiceSnapshotJson   String?   @map("invoice_snapshot_json") @db.LongText
  invoicePrintedAt      DateTime? @map("invoice_printed_at") @db.DateTime(0)
  invoicePrintedByStaffId Int?    @map("invoice_printed_by_staff_id")
  invoicePrintCount     Int       @default(0) @map("invoice_print_count")
  invoiceRevision       Int       @default(0) @map("invoice_revision")
  promotionPolicyAuditId Int?    @map("promotion_policy_audit_id")
  workshopParticipantId Int?     @map("workshop_participant_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  lead      CrmAcademyLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  evaluator CrmStaff?      @relation("AcademyTalentAssessmentEvaluator", fields: [evaluatorStaffId], references: [id], onDelete: SetNull)
  invoicePrintedBy CrmStaff? @relation("AcademyTalentAssessmentInvoicePrinter", fields: [invoicePrintedByStaffId], references: [id], onDelete: SetNull)
  promotionPolicyAudit CrmAcademyTalentPolicyAudit? @relation("AcademyTalentAssessmentPolicyAudit", fields: [promotionPolicyAuditId], references: [id], onDelete: SetNull)
  workshopParticipant CrmAcademyWorkshopParticipant? @relation(fields: [workshopParticipantId], references: [id], onDelete: SetNull)
  payments  CrmAcademyTalentPayment[]
  workshopBonuses CrmAcademyInstructorBonus[]

  @@index([leadId, createdAt])
  @@index([leadId, status])
  @@index([offerExpiresAt])
  @@index([promotionPolicyAuditId])
  @@index([workshopParticipantId, updatedAt])
  @@map("crm_academy_talent_assessments")
}

/// Append-only evidence of a global Tố Chất scholarship-policy change. An
/// assessment stores the version used to produce its invoice snapshot so
/// later reporting can attribute the policy actor without rewriting history.
model CrmAcademyTalentPolicyAudit {
  id               Int       @id @default(autoincrement())
  configKey        String    @map("config_key") @db.VarChar(80)
  policySnapshotJson String  @map("policy_snapshot_json") @db.LongText
  changedByStaffId Int?      @map("changed_by_staff_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  changedBy   CrmStaff?                  @relation("AcademyTalentPolicyAuditChanger", fields: [changedByStaffId], references: [id], onDelete: SetNull)
  assessments CrmAcademyTalentAssessment[] @relation("AcademyTalentAssessmentPolicyAudit")

  @@index([configKey, createdAt])
  @@index([changedByStaffId, createdAt])
  @@map("crm_academy_talent_policy_audits")
}

/// Append-only ledger for a confirmed Academy bank transfer. The QR itself is
/// only payment intent; a staff confirmation is required before this row is made.
model CrmAcademyTalentPayment {
  id                 Int       @id @default(autoincrement())
  assessmentId       Int       @map("assessment_id")
  amountVnd          Int       @map("amount_vnd")
  paymentMethod      String    @default("BANK_TRANSFER") @map("payment_method") @db.VarChar(24)
  reference          String?   @db.VarChar(160)
  note               String?   @db.Text
  receivedAt         DateTime  @map("received_at") @db.DateTime(0)
  confirmedByStaffId Int?      @map("confirmed_by_staff_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  assessment  CrmAcademyTalentAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  confirmedBy CrmStaff? @relation("AcademyTalentPaymentConfirmer", fields: [confirmedByStaffId], references: [id], onDelete: SetNull)

  @@index([assessmentId, receivedAt])
  @@index([confirmedByStaffId, createdAt])
  @@map("crm_academy_talent_payments")
}

