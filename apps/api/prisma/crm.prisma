datasource db {
  provider = "mysql"
  url      = env("CRM_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/crm-client"
}

model CrmStaff {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  role         String   @default("telesales") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active") @db.TinyInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  // HR System Extensions
  email            String?   @db.VarChar(100)
  phone            String?   @db.VarChar(20)
  joinedAt         DateTime? @map("joined_at") @db.Date
  birthDate        DateTime? @map("birth_date") @db.Date
  gender           String?   @db.VarChar(10)
  address          String?   @db.Text
  emergencyContact String?   @map("emergency_contact") @db.VarChar(100)
  emergencyPhone   String?   @map("emergency_phone") @db.VarChar(20)
  avatarUrl        String?   @map("avatar_url") @db.VarChar(255)
  notes            String?   @db.Text
  legacyStaffId    Int?      @map("legacy_staff_id")
  lastLoginAt      DateTime? @map("last_login_at") @db.DateTime(0)
  lastActiveAt     DateTime? @map("last_active_at") @db.DateTime(0)
  omicallAutoInit  Boolean?  @map("omicall_auto_init") @db.TinyInt
  baseSalary       Float?    @map("base_salary")
  hourlyWage       Float?    @map("hourly_wage")
  seniorityOffset  Int?      @default(0) @map("seniority_offset")

  customerAssignments CrmCustomerAssignment[]
  prevHistory         CrmAssignmentHistory[]  @relation("PrevStaffHistory")
  newHistory          CrmAssignmentHistory[]  @relation("NewStaffHistory")
  assignedHistory     CrmAssignmentHistory[]  @relation("AssignerHistory")
  assignedBatches     CrmAllocationBatch[]    @relation("BatchAssigner")
  receivedBatches     CrmAllocationBatch[]    @relation("BatchBooker")
  createdCampaigns    CrmCustomCampaign[]     @relation("CampaignCreator")
  socialPosts         CrmSocialPostSubmission[] @relation("SocialPostAuthor")
  reviewedSocialPosts CrmSocialPostSubmission[] @relation("SocialPostReviewer")

  @@map("crm_staff")
}

/// mOS-native social-post ledger. Historical Google Sheet imports are retained
/// for audit, while all new campaign intake is created directly in mOS.
model CrmSocialPostSubmission {
  id                 Int      @id @default(autoincrement())
  sourceSpreadsheetId String  @map("source_spreadsheet_id") @db.VarChar(100)
  sourceRecordId     Int?     @map("source_record_id")
  sourceUrlFingerprint String? @map("source_url_fingerprint") @db.VarChar(64)
  staffId            Int      @map("staff_id")
  sourceAuthorName   String   @map("source_author_name") @db.VarChar(100)
  contentType        String   @map("content_type") @db.VarChar(30)
  channel            String   @db.VarChar(150)
  sourceUrl          String   @map("source_url") @db.Text
  postedAt           DateTime @map("posted_at") @db.DateTime(0)
  reviewStatus       String   @default("PENDING") @map("review_status") @db.VarChar(20)
  reviewerComment    String?  @map("reviewer_comment") @db.Text
  reviewedAt         DateTime? @map("reviewed_at") @db.DateTime(0)
  reviewedByStaffId  Int?     @map("reviewed_by_staff_id")
  sourceReviewerName String?  @map("source_reviewer_name") @db.VarChar(100)
  importedAt         DateTime @default(now()) @map("imported_at") @db.DateTime(0)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  staff      CrmStaff  @relation("SocialPostAuthor", fields: [staffId], references: [id], onDelete: Restrict)
  reviewer   CrmStaff? @relation("SocialPostReviewer", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)

  @@unique([sourceSpreadsheetId, sourceRecordId], name: "sourceSpreadsheetId_sourceRecordId")
  @@unique([sourceSpreadsheetId, sourceUrlFingerprint], name: "sourceSpreadsheetId_sourceUrlFingerprint", map: "crm_post_source_fingerprint_key")
  @@index([postedAt])
  @@index([staffId, postedAt])
  @@index([reviewStatus, postedAt])
  @@map("crm_social_post_submissions")
}

model CrmDailyPlan {
  id           Int      @id @default(autoincrement())
  legacyUserId Int      @map("legacy_user_id")
  staffId      Int      @map("staff_id")
  plannedDate  DateTime @map("planned_date") @db.Date
  bucket       String?  @db.VarChar(20)
  priority     Int      @default(0)
  status       String   @default("PLANNED") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([legacyUserId, plannedDate], name: "legacyUserId_plannedDate")
  @@index([staffId, plannedDate])
  @@map("crm_daily_plans")
}

model CrmCallLog {
  id           Int       @id @default(autoincrement())
  planId       Int?      @map("plan_id")
  legacyUserId Int       @map("legacy_user_id")
  staffId      Int       @map("staff_id")
  callType     String    @map("call_type") @db.VarChar(20)
  callResult   String?   @map("call_result") @db.VarChar(20)
  durationSec  Int?      @map("duration_sec")
  note         String?   @db.Text
  outcome      String?   @db.VarChar(30)
  callbackDate DateTime? @map("callback_date") @db.Date
  callUuid     String?   @map("call_uuid") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([legacyUserId])
  @@index([staffId])
  @@index([createdAt])
  @@index([staffId, createdAt])
  @@map("crm_call_logs")
}

model CrmStaffKpi {
  id            Int      @id @default(autoincrement())
  staffId       Int      @map("staff_id")
  kpiDate       DateTime @map("kpi_date") @db.Date
  totalPlanned  Int      @default(0) @map("total_planned")
  totalCalled   Int      @default(0) @map("total_called")
  totalAnswered Int      @default(0) @map("total_answered")
  totalBooked   Int      @default(0) @map("total_booked")
  totalRenewed  Int      @default(0) @map("total_renewed")

  @@unique([staffId, kpiDate], name: "staffId_kpiDate")
  @@map("crm_staff_kpi")
}

model CrmConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("crm_config")
}

/// FAL itself is selected in Wings. MOS records only the explanation and
/// approval gate required before an existing Log may receive a ledger.
model CrmFalLogExplanation {
  id                       Int      @id @default(autoincrement())
  orderServiceId           BigInt   @unique @map("order_service_id")
  decisionStatus           String   @default("PENDING") @map("decision_status") @db.VarChar(12)
  ledgerStatus             String   @default("NOT_APPLIED") @map("ledger_status") @db.VarChar(16)
  explanation              String?  @db.Text
  explanationChannel       String?  @map("explanation_channel") @db.VarChar(30)
  explainedByStaffId       Int?     @map("explained_by_staff_id")
  approvedByStaffId        Int?     @map("approved_by_staff_id")
  approvedAt               DateTime? @map("approved_at") @db.DateTime(0)
  rejectionReason          String?  @map("rejection_reason") @db.Text
  appliedAt                DateTime? @map("applied_at") @db.DateTime(0)
  failureReason            String?  @map("failure_reason") @db.Text
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  audits CrmFalLogExplanationAudit[]

  @@index([decisionStatus])
  @@index([ledgerStatus])
  @@map("crm_fal_log_explanations")
}

model CrmFalLogExplanationAudit {
  id         Int      @id @default(autoincrement())
  decisionId Int      @map("decision_id")
  action     String   @db.VarChar(30)
  actorStaffId Int?   @map("actor_staff_id")
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  decision CrmFalLogExplanation @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
  @@map("crm_fal_log_explanation_audits")
}

model CrmCustomerAssignment {
  id                   Int       @id @default(autoincrement())
  legacyUserId         Int       @unique @map("legacy_user_id")
  staffId              Int?      @map("staff_id")
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.DateTime(0)
  assignedBy           Int?      @map("assigned_by")
  expiresAt            DateTime? @map("expires_at") @db.DateTime(0)
  assignedDurationDays Int?      @map("assigned_duration_days")
  isRetained           Boolean   @default(false) @map("is_retained") @db.TinyInt
  retainedAt           DateTime? @map("retained_at") @db.DateTime(0)
  staff                CrmStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@map("crm_customer_assignments")
}

model CrmRole {
  key             String   @id @db.VarChar(20)
  name            String   @db.VarChar(100)
  color           String   @default("default") @db.VarChar(20)
  viewKPI         Boolean  @default(false) @map("view_kpi") @db.TinyInt
  viewTeamKPI     Boolean  @default(false) @map("view_team_kpi") @db.TinyInt
  manageStaff     Boolean  @default(false) @map("manage_staff") @db.TinyInt
  omicallAutoInit Boolean  @default(false) @map("omicall_auto_init") @db.TinyInt
  isSystem        Boolean  @default(false) @map("is_system") @db.TinyInt
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@map("crm_roles")
}

model CrmAssignmentHistory {
  id                  Int       @id @default(autoincrement())
  batchId             String    @map("batch_id") @db.VarChar(50)
  legacyUserId        Int       @map("legacy_user_id")
  prevStaffId         Int?      @map("prev_staff_id")
  newStaffId          Int?      @map("new_staff_id")
  assignedBy          Int       @map("assigned_by")
  assignedAt          DateTime  @default(now()) @map("assigned_at") @db.DateTime(0)
  expiresAt           DateTime? @map("expires_at") @db.DateTime(0)
  sourceType          String    @default("MANUAL") @map("source_type") @db.VarChar(20)
  sourceFilterJson    String?   @map("source_filter_json") @db.Text
  sourceFilterSummary String?   @map("source_filter_summary") @db.Text
  actionType          String    @default("ASSIGN") @map("action_type") @db.VarChar(20)
  reason              String?   @map("reason") @db.Text
  isUndone            Boolean   @default(false) @map("is_undone") @db.TinyInt
  undoneAt            DateTime? @map("undone_at") @db.DateTime(0)

  prevStaff CrmStaff? @relation("PrevStaffHistory", fields: [prevStaffId], references: [id], onDelete: SetNull)
  newStaff  CrmStaff? @relation("NewStaffHistory", fields: [newStaffId], references: [id], onDelete: SetNull)
  assigner  CrmStaff  @relation("AssignerHistory", fields: [assignedBy], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([legacyUserId])
  @@map("crm_assignment_history")
}

// ═══════════════════════════════════════════
// OmiCall Integration — Raw webhook data + AI results
// ═══════════════════════════════════════════
model CrmOmicallLog {
  id                Int       @id @default(autoincrement())
  callUuid          String    @unique @map("call_uuid") @db.VarChar(100)
  direction         String    @db.VarChar(10) // 'outbound' | 'inbound'
  status            String    @db.VarChar(20) // 'ANSWER' | 'NOANSWER' | 'BUSY' | 'CANCEL'
  sourceNumber      String    @map("source_number") @db.VarChar(20)
  destinationNumber String    @map("destination_number") @db.VarChar(20)
  duration          Int       @default(0) // total seconds
  billSec           Int       @default(0) @map("bill_sec") // billable seconds
  recordingUrl      String?   @map("recording_url") @db.VarChar(500)
  timeStartCall     DateTime? @map("time_start_call") @db.DateTime(0)
  timeEndCall       DateTime? @map("time_end_call") @db.DateTime(0)

  // Linking
  staffId      Int? @map("staff_id") // matched CRM staff
  legacyUserId Int? @map("legacy_user_id") // matched customer
  callLogId    Int? @map("call_log_id") // linked CrmCallLog (notes/tags)

  // AI Analysis
  analysisStatus     String  @default("PENDING") @map("analysis_status") @db.VarChar(20)
  // PENDING → WAITING_RECORDING → PROCESSING → DONE → FAILED | SKIPPED
  analysisRetryCount Int     @default(0) @map("analysis_retry_count")
  analysisError      String? @map("analysis_error") @db.Text
  laughCount         Int?    @map("laugh_count")
  laughCountAgent    Int?    @map("laugh_count_agent")
  laughCountCustomer Int?    @map("laugh_count_customer")
  laughTimestamps    String? @map("laugh_timestamps") @db.Text
  // JSON: [{"start":12.5,"end":14.2,"speaker":"agent"|"customer","confidence":0.92}, ...]
  transcript         String? @db.LongText

  // Customer Satisfaction (CSAT) Evaluation Fields
  customerSatisfactionScore Int?    @map("customer_satisfaction_score")
  customerSentiment         String? @map("customer_sentiment") @db.VarChar(20)
  satisfactionAnalysis      String? @map("satisfaction_analysis") @db.Text

  // Happy Call Status (thay thế isHappyCall boolean)
  happyCallStatus String  @default("NONE") @map("happy_call_status") @db.VarChar(20)
  // NONE | APPROVED | PENDING_APPROVAL | REJECTED
  happyCallReason String? @map("happy_call_reason") @db.VarChar(30)
  // 'auto_180s' | 'auto_laughter_30s' | 'manual_approved' | null

  // QA Verification (Positive Feedback per laugh)
  qaVerified           Boolean   @default(false) @map("qa_verified") @db.TinyInt
  qaVerifiedBy         Int?      @map("qa_verified_by")
  qaVerifiedAt         DateTime? @map("qa_verified_at") @db.DateTime(0)
  qaLaughVerifications String?   @map("qa_laugh_verifications") @db.Text
  // JSON: [{"timestamp":12.5,"verified":true}, {"timestamp":45.8,"verified":false}]
  qaNotes              String?   @map("qa_notes") @db.Text
  qaScore              Int?      @map("qa_score")
  qaTags               String?   @map("qa_tags") @db.Text
  qaChecklist          String?   @map("qa_checklist") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([staffId])
  @@index([legacyUserId])
  @@index([analysisStatus])
  @@index([happyCallStatus])
  @@index([createdAt])
  @@index([destinationNumber])
  @@index([status, createdAt])
  @@map("crm_omicall_logs")
}

// ═══════════════════════════════════════════
// OmiCall Config — API keys, extension mapping
// ═══════════════════════════════════════════
model CrmOmicallConfig {
  id          Int     @id @default(autoincrement())
  staffId     Int     @unique @map("staff_id")
  extension   String  @db.VarChar(20) // SIP extension number
  phoneNumber String? @map("phone_number") @db.VarChar(20) // Outbound caller ID
  sipPassword String? @map("sip_password") @db.VarChar(255) // SIP password (đã mã hóa)

  @@map("crm_omicall_config")
}

model CrmMissedLog {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique @map("order_id")
  reasonCategory String    @map("reason_category") @db.VarChar(50)
  responsibility String    @db.VarChar(50)
  note           String?   @db.Text
  followUpStatus String    @default("PENDING") @map("follow_up_status") @db.VarChar(30)
  callbackDate   DateTime? @map("callback_date") @db.Date
  createdBy      String?   @map("created_by") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([reasonCategory])
  @@index([responsibility])
  @@index([followUpStatus])
  @@index([createdAt])
  @@map("crm_missed_logs")
}

// ═══════════════════════════════════════════
// Team Configuration — Unified team/group management
// ═══════════════════════════════════════════
model CrmTeam {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(30) // CC, CV, BK, BK_TELESALES...
  name         String   @db.VarChar(100) // Display name
  description  String?  @db.Text
  color        String?  @db.VarChar(30) // Hex or named color
  icon         String?  @db.VarChar(50) // Emoji or icon name
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active") @db.TinyInt
  parentTeamId Int?     @map("parent_team_id")
  metadata     String?  @db.Text // JSON: salary config, bonus formula
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  // Self-referencing hierarchy
  parent   CrmTeam?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children CrmTeam[]       @relation("TeamHierarchy")
  members  CrmTeamMember[]

  @@index([parentTeamId])
  @@index([isActive])
  @@map("crm_teams")
}

model CrmTeamMember {
  id            Int       @id @default(autoincrement())
  teamId        Int       @map("team_id")
  legacyStaffId Int       @map("legacy_staff_id")
  crmStaffId    Int?      @map("crm_staff_id")
  displayName   String?   @map("display_name") @db.VarChar(100)
  role          String?   @db.VarChar(20) // leader, member, trainee
  isActive      Boolean   @default(true) @map("is_active") @db.TinyInt
  sortOrder     Int       @default(0) @map("sort_order")
  joinedAt      DateTime  @default(now()) @map("joined_at") @db.DateTime(0)
  leftAt        DateTime? @map("left_at") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  team CrmTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, legacyStaffId], name: "teamId_legacyStaffId")
  @@index([legacyStaffId])
  @@index([crmStaffId])
  @@index([isActive])
  @@map("crm_team_members")
}

// ═══════════════════════════════════════════
// Booking Audit Logs — Trace changes & cross-booker cancellations
// ═══════════════════════════════════════════
model CrmBookingLog {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  actionType        String   @map("action_type") @db.VarChar(30) // CANCEL, RESCHEDULE, CHANGE_CV, CHANGE_STORE, EDIT
  actorStaffId      Int      @map("actor_staff_id")
  actorStaffName    String?  @map("actor_staff_name") @db.VarChar(100)
  originalStaffId   Int?     @map("original_staff_id")
  originalStaffName String?  @map("original_staff_name") @db.VarChar(100)
  isCrossAction     Boolean  @default(false) @map("is_cross_action")
  reasonCategory    String?  @map("reason_category") @db.VarChar(100)
  reasonNote        String?  @map("reason_note") @db.Text
  oldDataJson       String?  @map("old_data_json") @db.Text
  newDataJson       String?  @map("new_data_json") @db.Text
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  dateCreated       DateTime @default(now()) @map("date_created") @db.DateTime(0)

  @@index([orderId])
  @@index([actorStaffId])
  @@index([originalStaffId])
  @@index([isCrossAction])
  @@index([dateCreated])
  @@map("crm_booking_logs")
}

// ═══════════════════════════════════════════
// Customer Allocation System — 2-step verification, 24h countdown, 30-day retention
// ═══════════════════════════════════════════
model CrmAllocationBatch {
  id                  Int       @id @default(autoincrement())
  batchCode           String    @unique @map("batch_code") @db.VarChar(50)
  campaignId          Int?      @map("campaign_id")
  assignerId          Int       @map("assigner_id")
  bookerId            Int       @map("booker_id")
  totalCount          Int       @map("total_count")
  status              String    @default("PENDING_ACCEPT") @db.VarChar(20) // PENDING_ACCEPT | ACCEPTED | DECLINED | EXPIRED | RECALLED
  declineReason       String?   @map("decline_reason") @db.Text
  declineCategory     String?   @map("decline_category") @db.VarChar(100)
  declineNote         String?   @map("decline_note") @db.Text
  expiresAt           DateTime  @map("expires_at") @db.DateTime(0) // 24h countdown target
  acceptedAt          DateTime? @map("accepted_at") @db.DateTime(0)
  declinedAt          DateTime? @map("declined_at") @db.DateTime(0)
  recalledAt          DateTime? @map("recalled_at") @db.DateTime(0)
  retentionExpiresAt  DateTime? @map("retention_expires_at") @db.DateTime(0) // 30-day countdown target
  sourceFilterSummary String?   @map("source_filter_summary") @db.Text
  sourceFilterJson    String?   @map("source_filter_json") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  campaign CrmCustomCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assigner CrmStaff                 @relation("BatchAssigner", fields: [assignerId], references: [id], onDelete: Cascade)
  booker   CrmStaff                 @relation("BatchBooker", fields: [bookerId], references: [id], onDelete: Cascade)
  items    CrmAllocationBatchItem[]

  @@index([campaignId])
  @@index([bookerId])
  @@index([assignerId])
  @@index([status])
  @@index([expiresAt])
  @@map("crm_allocation_batches")
}

model CrmAllocationBatchItem {
  id                 Int      @id @default(autoincrement())
  batchId            Int      @map("batch_id")
  customerId         Int      @map("customer_id")
  customerName       String?  @map("customer_name") @db.VarChar(100)
  customerPhone      String?  @map("customer_phone") @db.VarChar(20)
  bucket             String?  @db.VarChar(50)
  daysSinceLastVisit Int?     @map("days_since_last_visit")
  totalSpent         Float?   @map("total_spent")
  status             String   @default("PENDING_ACCEPT") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(0)

  batch CrmAllocationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, customerId], name: "batchId_customerId")
  @@index([customerId])
  @@index([batchId])
  @@index([status])
  @@map("crm_allocation_batch_items")
}

// ═══════════════════════════════════════════
// LoCa Customer Touchpoint Tracking (24h, 17, 19, 21, 23, 25, 30, 30+)
// ═══════════════════════════════════════════
model CrmLocaTouchpoint {
  id                 Int       @id @default(autoincrement())
  legacyUserId       Int       @map("legacy_user_id")
  touchpointKey      String    @map("touchpoint_key") @db.VarChar(20) // '24h', '17', '19', '21', '23', '25', '30', '30plus'
  isChecked          Boolean   @default(false) @map("is_checked") @db.TinyInt
  status             String?   @db.VarChar(30) // SUCCESS | FAILED | LOST
  checkedAt          DateTime? @map("checked_at") @db.DateTime(0)
  checkedByStaffId   Int?      @map("checked_by_staff_id")
  checkedByStaffName String?   @map("checked_by_staff_name") @db.VarChar(100)
  note               String?   @db.Text
  cycleDate          DateTime? @map("cycle_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([legacyUserId, cycleDate, touchpointKey], name: "legacyUserId_cycleDate_touchpointKey")
  @@index([legacyUserId])
  @@index([touchpointKey])
  @@index([cycleDate])
  @@map("crm_loca_touchpoints")
}

// ═══════════════════════════════════════════
// Custom Sub-Campaign Models (NYC Sub-Campaign System)
// ═══════════════════════════════════════════

model CrmCustomCampaign {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(100)
  slug             String    @unique @db.VarChar(100)
  description      String?   @db.Text
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  status           String    @default("ACTIVE") @db.VarChar(20) // DRAFT | SCHEDULED | ACTIVE | PAUSED | COMPLETED | ENDED | ARCHIVED
  createdBy        Int?      @map("created_by")
  assignedStaffIds String?   @map("assigned_staff_ids") @db.Text
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  creator           CrmStaff?               @relation("CampaignCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  customers         CrmCampaignCustomer[]
  touchpoints       CrmCampaignTouchpoint[]
  promotions        CrmCampaignPromotion[]
  allocationBatches CrmAllocationBatch[]

  @@index([status])
  @@index([createdBy])
  @@map("crm_custom_campaigns")
}

model CrmCampaignCustomer {
  id            Int       @id @default(autoincrement())
  campaignId    Int       @map("campaign_id")
  legacyUserId  Int       @map("legacy_user_id")
  addedAt       DateTime  @default(now()) @map("added_at") @db.DateTime(0)
  addedBy       Int?      @map("added_by")
  removedAt     DateTime? @map("removed_at") @db.DateTime(0)
  removedReason String?   @map("removed_reason") @db.Text
  removedBy     Int?      @map("removed_by")

  campaign       CrmCustomCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  touchpointLogs CrmCampaignTouchpointLog[]

  @@index([campaignId])
  @@index([legacyUserId])
  @@index([removedAt])
  @@index([legacyUserId, removedAt])
  @@index([campaignId, removedAt])
  @@map("crm_campaign_customers")
}

model CrmCampaignTouchpoint {
  id         Int      @id @default(autoincrement())
  campaignId Int      @map("campaign_id")
  key        String   @db.VarChar(50)
  label      String   @db.VarChar(100)
  icon       String?  @db.VarChar(50)
  daysMin    Int      @map("days_min")
  daysMax    Int?     @map("days_max")
  color      String?  @db.VarChar(30)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  campaign CrmCustomCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  logs     CrmCampaignTouchpointLog[]

  @@unique([campaignId, key], name: "campaignId_key")
  @@index([campaignId])
  @@map("crm_campaign_touchpoints")
}

model CrmCampaignPromotion {
  id                Int      @id @default(autoincrement())
  campaignId        Int      @map("campaign_id")
  name              String   @db.VarChar(150)
  code              String?  @db.VarChar(50)
  type              String   @db.VarChar(30) // PERCENT_DISCOUNT | FIXED_DISCOUNT | FREE_SERVICE | FREE_PRODUCT
  value             Float    @default(0)
  description       String?  @db.Text
  isActive          Boolean  @default(true) @map("is_active") @db.TinyInt
  legacyPromotionId Int?     @map("legacy_promotion_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  campaign CrmCustomCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([isActive])
  @@map("crm_campaign_promotions")
}

model CrmCampaignTouchpointLog {
  id                   Int      @id @default(autoincrement())
  campaignCustomerId   Int      @map("campaign_customer_id")
  touchpointId         Int      @map("touchpoint_id")
  isChecked            Boolean  @default(true) @map("is_checked") @db.TinyInt
  status               String?  @db.VarChar(30) // SUCCESS | FAILED | LOST
  completedAt          DateTime @default(now()) @map("completed_at") @db.DateTime(0)
  completedByStaffId   Int?     @map("completed_by_staff_id")
  completedByStaffName String?  @map("completed_by_staff_name") @db.VarChar(100)
  note                 String?  @db.Text

  campaignCustomer CrmCampaignCustomer   @relation(fields: [campaignCustomerId], references: [id], onDelete: Cascade)
  touchpoint       CrmCampaignTouchpoint @relation(fields: [touchpointId], references: [id], onDelete: Cascade)

  @@unique([campaignCustomerId, touchpointId], name: "campaignCustomerId_touchpointId")
  @@index([campaignCustomerId])
  @@index([touchpointId])
  @@map("crm_campaign_touchpoint_logs")
}

// ═══════════════════════════════════════════
// Customer Support (CS) Module
// ═══════════════════════════════════════════

model CrmHappyCallTask {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  customerId        Int       @map("customer_id")
  assignedCsStaffId Int?      @map("assigned_cs_staff_id")
  status            String    @default("PENDING") @db.VarChar(20)
  attemptCount      Int       @default(0) @map("attempt_count")
  scheduledDate     DateTime  @map("scheduled_date") @db.Date
  completedAt       DateTime? @map("completed_at") @db.DateTime(0)
  checkoutDate      DateTime? @map("checkout_date") @db.DateTime(0)
  technicianId      Int?      @map("technician_id")
  ccInStaffId       Int?      @map("cc_in_staff_id")
  ccOutStaffId      Int?      @map("cc_out_staff_id")
  bookerStaffId     Int?      @map("booker_staff_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  surveyRating CrmSurveyRating?
  tickets      CrmCsTicket[]

  @@index([orderId])
  @@index([customerId])
  @@index([assignedCsStaffId])
  @@index([status])
  @@index([scheduledDate])
  @@map("crm_happy_call_tasks")
}

model CrmSurveyRating {
  id                       Int      @id @default(autoincrement())
  happyCallTaskId          Int      @unique @map("happy_call_task_id")
  orderId                  Int      @map("order_id")
  customerId               Int      @map("customer_id")
  overallRating            Int      @map("overall_rating") @db.TinyInt
  technicianQualityRating  Int?     @map("technician_quality_rating") @db.TinyInt
  staffAttitudeRating      Int?     @map("staff_attitude_rating") @db.TinyInt
  facilityRating           Int?     @map("facility_rating") @db.TinyInt
  valueForMoneyRating      Int?     @map("value_for_money_rating") @db.TinyInt
  checkInExperienceRating  Int?     @map("check_in_experience_rating") @db.TinyInt
  checkOutExperienceRating Int?     @map("check_out_experience_rating") @db.TinyInt
  bookingExperienceRating  Int?     @map("booking_experience_rating") @db.TinyInt
  customerNote             String?  @map("customer_note") @db.Text
  csNote                   String?  @map("cs_note") @db.Text
  technicianId             Int?     @map("technician_id")
  ccInStaffId              Int?     @map("cc_in_staff_id")
  ccOutStaffId             Int?     @map("cc_out_staff_id")
  bookerStaffId            Int?     @map("booker_staff_id")
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  happyCallTask CrmHappyCallTask @relation(fields: [happyCallTaskId], references: [id], onDelete: Cascade)
  tickets       CrmCsTicket[]

  @@index([orderId])
  @@index([customerId])
  @@map("crm_survey_ratings")
}

model CrmCsTicket {
  id                Int       @id @default(autoincrement())
  ticketCode        String    @unique @map("ticket_code") @db.VarChar(20)
  surveyRatingId    Int?      @map("survey_rating_id")
  happyCallTaskId   Int?      @map("happy_call_task_id")
  orderId           Int?      @map("order_id")
  customerId        Int?      @map("customer_id")
  type              String    @db.VarChar(30)
  priority          String    @default("MEDIUM") @db.VarChar(10)
  status            String    @default("OPEN") @db.VarChar(20)
  department        String?   @db.VarChar(20)
  relatedStaffId    Int?      @map("related_staff_id")
  assignedCsStaffId Int?      @map("assigned_cs_staff_id")
  description       String    @db.Text
  slaDueDate        DateTime? @map("sla_due_date") @db.DateTime(0)
  resolutionNote    String?   @map("resolution_note") @db.Text
  actionPlan        String?   @map("action_plan") @db.Text
  resolvedAt        DateTime? @map("resolved_at") @db.DateTime(0)
  resolvedByStaffId Int?      @map("resolved_by_staff_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  surveyRating  CrmSurveyRating?     @relation(fields: [surveyRatingId], references: [id], onDelete: SetNull)
  happyCallTask CrmHappyCallTask?    @relation(fields: [happyCallTaskId], references: [id], onDelete: SetNull)
  comments      CrmCsTicketComment[]
  subtasks      CrmCsTicketSubtask[]

  @@index([surveyRatingId])
  @@index([happyCallTaskId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([department])
  @@map("crm_cs_tickets")
}

model CrmCsTicketSubtask {
  id                        Int       @id @default(autoincrement())
  ticketId                  Int       @map("ticket_id")
  department                String    @db.VarChar(20)
  assignedStaffId           Int?      @map("assigned_staff_id")
  status                    String    @default("PENDING") @db.VarChar(30)
  // PENDING | APPOINTMENT_SCHEDULED | RESOLVED
  issueSummary              String?   @map("issue_summary") @db.Text
  resolutionNote            String?   @map("resolution_note") @db.Text
  actionPlan                String?   @map("action_plan") @db.Text
  technicalIssueTags        String?   @map("technical_issue_tags") @db.VarChar(255)
  warrantyType              String?   @map("warranty_type") @db.VarChar(50)
  isWithin3DayWarranty      Boolean   @default(false) @map("is_within_3day_warranty") @db.TinyInt
  previousTechnicianId      Int?      @map("previous_technician_id")
  replacementTechnicianId   Int?      @map("replacement_technician_id")
  warrantyAppointmentDate   DateTime? @map("warranty_appointment_date") @db.DateTime(0)
  nextFalOrderServiceId     BigInt?   @map("next_fal_order_service_id")
  inspectionStoreName       String?   @map("inspection_store_name") @db.VarChar(100)
  inspectionAppointmentDate DateTime? @map("inspection_appointment_date") @db.DateTime(0)
  inspectionResultNote      String?   @map("inspection_result_note") @db.Text
  resolvedAt                DateTime? @map("resolved_at") @db.DateTime(0)
  resolvedByStaffId         Int?      @map("resolved_by_staff_id")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  ticket CrmCsTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([department])
  @@index([assignedStaffId])
  @@index([status])
  @@map("crm_cs_ticket_subtasks")
}

model CrmCsTicketComment {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  staffId    Int      @map("staff_id")
  staffName  String?  @map("staff_name") @db.VarChar(100)
  content    String   @db.Text
  isInternal Boolean  @default(true) @map("is_internal") @db.TinyInt
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  ticket CrmCsTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("crm_cs_ticket_comments")
}

model CrmCsCampaign {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(200)
  description      String?   @db.Text
  target           String    @db.VarChar(30)
  status           String    @default("DRAFT") @db.VarChar(20)
  dateFrom         DateTime? @map("date_from") @db.Date
  dateTo           DateTime? @map("date_to") @db.Date
  filterBucket     String?   @map("filter_bucket") @db.VarChar(20)
  sampleSize       Int?      @map("sample_size")
  createdByStaffId Int       @map("created_by_staff_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  tasks CrmCsCampaignTask[]

  @@index([status])
  @@map("crm_cs_campaigns")
}

model CrmCsCampaignTask {
  id                Int       @id @default(autoincrement())
  campaignId        Int       @map("campaign_id")
  orderId           Int       @map("order_id")
  customerId        Int       @map("customer_id")
  assignedCsStaffId Int?      @map("assigned_cs_staff_id")
  status            String    @default("PENDING") @db.VarChar(20)
  attemptCount      Int       @default(0) @map("attempt_count")
  surveyRatingId    Int?      @map("survey_rating_id")
  completedAt       DateTime? @map("completed_at") @db.DateTime(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  campaign CrmCsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("crm_cs_campaign_tasks")
}

model CrmLashTypeBenchmark {
  id               Int      @id @default(autoincrement())
  lashStyle        String   @map("lash_style") @db.VarChar(50)
  serviceType      String   @map("service_type") @db.VarChar(30)
  lashCount        Int?     @map("lash_count")
  benchmarkMinutes Int      @map("benchmark_minutes")
  minMinutes       Int      @map("min_minutes")
  maxMinutes       Int      @map("max_minutes")
  sampleSize       Int      @default(0) @map("sample_size")
  isAutoGenerated  Boolean  @default(true) @map("is_auto_generated") @db.TinyInt
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([lashStyle, serviceType, lashCount], name: "style_type_count")
  @@map("crm_lash_type_benchmarks")
}

model CrmCvSpeedProfile {
  id                    Int      @id @default(autoincrement())
  staffId               Int      @map("staff_id")
  staffName             String?  @map("staff_name") @db.VarChar(100)
  lashStyle             String   @map("lash_style") @db.VarChar(50)
  serviceMode           String   @map("service_mode") @db.VarChar(20)
  lashCount             Int      @map("lash_count")
  cleaningMinutes       Float    @map("cleaning_minutes")
  extensionMinutes      Float    @map("extension_minutes")
  prepQcMinutes         Float    @map("prep_qc_minutes")
  totalMinutes          Float    @map("total_minutes")
  modelLayer            Int      @map("model_layer")
  sampleSize            Int      @map("sample_size")
  confidence            String   @db.VarChar(10)
  regA                  Float?   @map("reg_a")
  regB                  Float?   @map("reg_b")
  regRSquared           Float?   @map("reg_r_squared")
  benchmarkTotalMinutes Float?   @map("benchmark_total_minutes")
  speedDeltaPercent     Float?   @map("speed_delta_percent")
  speedRating           String   @map("speed_rating") @db.VarChar(10)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([staffId, lashStyle, serviceMode, lashCount], name: "staffId_lashStyle_serviceMode_lashCount")
  @@index([staffId])
  @@index([lashStyle])
  @@index([speedRating])
  @@map("crm_cv_speed_profile")
}

// ═══════════════════════════════════════════
// Branch Management (Catalog Stores)
// ═══════════════════════════════════════════
model CrmStore {
  id                  Int      @id @default(autoincrement())
  code                String   @unique @db.VarChar(30)
  name                String   @db.VarChar(100)
  nameEn              String?  @map("name_en") @db.VarChar(100)
  storeType           String   @default("SALON") @map("store_type") @db.VarChar(20)
  addressMap          String?  @map("address_map") @db.VarChar(255)
  addressSms          String?  @map("address_sms") @db.VarChar(255)
  addressWeb          String?  @map("address_web") @db.VarChar(255)
  addressCity         String?  @map("address_city") @db.VarChar(255)
  sortOrder           Int      @default(0) @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active") @db.TinyInt
  legacyClientStoreId Int?     @unique @map("legacy_client_store_id")
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([code])
  @@index([isActive])
  @@index([storeType])
  @@map("crm_stores")
}

// Records idempotent, versioned production data migrations executed by the deploy pipeline.
model CrmDataMigration {
  id          String   @id @db.VarChar(191)
  checksum    String   @db.Char(64)
  description String   @db.Text
  commitSha   String?  @map("commit_sha") @db.VarChar(64)
  durationMs  Int      @map("duration_ms")
  appliedAt   DateTime @default(now()) @map("applied_at") @db.DateTime(0)

  @@map("crm_data_migrations")
}
