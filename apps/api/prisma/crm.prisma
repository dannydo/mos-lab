  phone            String?   @db.VarChar(50)
  phoneNormalized  String?   @map("phone_normalized") @db.VarChar(30)
  searchText       String    @default("") @map("search_text") @db.VarChar(1000)
  email            String?   @db.VarChar(150)
  status           String    @default("NEW") @db.VarChar(20)
  course           String?   @db.VarChar(150)
  goal             String?   @db.Text
  flightDate       DateTime? @map("flight_date") @db.Date
  scheduledAt      DateTime? @map("scheduled_at") @db.DateTime(0)
  revenueVnd       Int       @default(0) @map("revenue_vnd")
  isHot            Boolean   @default(false) @map("is_hot") @db.TinyInt
